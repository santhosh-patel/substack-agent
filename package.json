{
  "name": "substack-agent",
  "version": "1.1.0",
  "description": "Automate Substack posts with AI-powered content generation — MCP server and tool-calling API for AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/santhosh-patel/substack-agent.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build:landing": "npm run build --prefix landing-page && node scripts/sync-landing-dist.mjs",
    "build": "npm run build:landing",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint --prefix landing-page",
    "mcp": "npx tsx src/mcp-server.ts",
    "ci:static": "node scripts/ci-static.js",
    "test:api": "node scripts/test-apis.js",
    "test:auth": "node scripts/test-auth.js",
    "test:smoke": "node scripts/test-smoke.js",
    "test": "npm run typecheck && npm run lint && npm run build && npm run ci:static"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "got-scraping": "^4.2.1",
    "marked": "^15.0.0",
    "substack-api": "^1.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
