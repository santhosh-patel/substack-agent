# Substack session (required)
SUBSTACK_SID=
SUBSTACK_PUB_URL=yourname.substack.com

# AI providers (optional — needed for generation and comment automation)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY is also used for Default preset sketch illustrations (DALL-E 3)

# Tool API auth (required in production / Vercel deployments)
API_SECRET=

# Cron auth for /api/cron/process-schedules (optional; falls back to API_SECRET)
CRON_SECRET=

# Note: On Vercel, scheduler/history data uses ephemeral /tmp storage unless KV is configured.
